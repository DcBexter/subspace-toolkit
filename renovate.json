{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "ignoreTests": false,
  "dependencyDashboardApproval": false,
  "major": {
    "dependencyDashboardApproval": false,
    "automerge": true
  },
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "rebaseWhen": "behind-base-branch",
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "cargo install (?<depName>cargo-audit) --locked --version (?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "crate"
    }
  ]
}
